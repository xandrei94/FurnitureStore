@model List<CustomerUser>


<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Product List</h2>
            </div>
        </div>
    </div>
   
    <p>Users can only be edited or deleted. Only way to create new users is through registration.</p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    Name
                </th>
                <th>
                    Email
                </th>
                <th>
                    PhoneNumber
                </th>
                <th>
                    Discount Type
                </th>
                <th>
                    Discount(%)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td>@obj.Email</td>
                    <td>@obj.PhoneNumber</td>
                    <td>@obj.Discount.Name</td>
                    <td>@obj.Discount.Percentage%</td>

                    @* <td>@obj.CustomerUser.Name</td>
                <td>@obj.CustomerUser.Email</td>
                <td>@obj.CustomerUser.PhoneNumber</td>
                <td>@obj.Discount.Name</td>
                <td>@obj.Discount.Percentage.ToString("0.00")%</td> *@
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-area="Admin" asp-controller="Customer" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> edit
                            </a>
                            <a class="deleteButton btn btn-danger mx-2" asp-area="Admin" asp-controller="Customer" asp-action="Delete" asp-route-id="@obj.Id">
                                <i class="bi bi-trash-fill"></i> delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    const deleteButtons = document.querySelectorAll('.deleteButton');
    deleteButtons.forEach(button => {
        button.addEventListener('click', function (event) {
            if (!confirm('Are you sure you want to delete this customer?')) {
                event.preventDefault(); // Prevent the default action (cancel the request)
            }
        });
    });
</script>